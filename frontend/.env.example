# ── BookVibe Frontend (Vite) ──
# Copy to ".env" and fill in. Only VITE_-prefixed vars are exposed to the browser.
#   cp .env.example .env

# Backend API base URL. IMPORTANT: include the /api/v1 suffix — the app calls
# `${VITE_API_URL}/...` directly and derives the Socket.io origin by stripping it.
VITE_API_URL=http://localhost:3000/api/v1

# Secret admin route segment (path only — no domain, no leading slash),
# e.g. ctrl-bv5ap6. The admin panel is served at /<VITE_ADMIN_PATH>/...
VITE_ADMIN_PATH=ctrl-bv5ap6

# --- AWS Face Liveness (browser) — see AWS_FACE_LIVENESS_SETUP.md ---
# Must be a Face-Liveness-supported region (e.g. us-east-1, us-west-2, eu-west-1).
VITE_AWS_REGION=us-east-1
# Cognito Identity Pool id that grants guests rekognition:StartFaceLivenessSession.
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
