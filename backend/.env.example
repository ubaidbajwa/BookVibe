# ── BookVibe Backend (Express 5 API) ──
# Copy to ".env" and fill in real values. Never commit the real .env.
#   cp .env.example .env

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database ---
MONGO_URL=mongodb://localhost:27017/bookvibe

# --- Auth / JWT ---
# ACCESS_TOKEN_SECRET_KEY and REFRESH_TOKEN_SECRET_KEY are used first; each falls
# back to JWT_SECRET_KEY if unset. Use long random strings.
JWT_SECRET_KEY=change_me_long_random_string
ACCESS_TOKEN_SECRET_KEY=change_me_long_random_string
REFRESH_TOKEN_SECRET_KEY=change_me_long_random_string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Optional — override the refresh-cookie SameSite policy (default lax).
# COOKIE_SAME_SITE=lax

# --- CORS allowlist (frontend origins) ---
CLIENT_URL=http://localhost:5173
# Comma-separated additional origins (optional).
CLIENT_URLS=http://localhost:5173

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (Gmail app password) ---
MY_EMAIL=you@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Identity verification microservice ---
# Either variable is accepted; PYTHON_VERIFICATION_URL takes precedence.
PYTHON_VERIFY_URL=http://localhost:5001
# PYTHON_VERIFICATION_URL=http://localhost:5001
# Shared secret sent as the X-Internal-Key header. Must equal INTERNAL_API_KEY in
# python-verification-service/.env. Generate with: openssl rand -hex 32
PYTHON_INTERNAL_KEY=

# --- Admin second factor ---
# 6-digit PIN required to enter the admin panel. Defaults to 000000 if unset —
# set a strong value before deploying.
ADMIN_PIN=000000

# --- Web Push (VAPID) ---
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- SMS (Twilio) — optional; SMS is skipped if unset ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# --- Redis — optional ---
# REDIS_URL=redis://localhost:6379
